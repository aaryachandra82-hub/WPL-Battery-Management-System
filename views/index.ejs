<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container" style="flex: 1; padding-bottom: 50px;">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-pill">⚡ College Web Development Laboratory &bull; Experiment 6</div>
    <h1 class="hero-title">Battery Management System</h1>
    <p class="hero-subtitle">
      A full-stack industrial telemetry and diagnostics suite engineered with Node.js, Express.js, EJS, and the native File System (<code style="color: var(--accent-neon);">fs</code>) module.
    </p>

    <div class="btn-group">
      <a href="/battery" class="btn btn-primary">
        <span>📊 Open Battery Dashboard</span>
      </a>
      <a href="/status" target="_blank" class="btn btn-outline">
        <span>🔌 Test /status JSON Endpoint</span>
      </a>
      <a href="/about" class="btn btn-outline">
        <span>📖 Lab Manual &amp; Theory</span>
      </a>
    </div>
  </section>

  <!-- Quick Telemetry Snapshot (if battery loaded) -->
  <% if (battery) { %>
  <section style="margin-bottom: 40px;">
    <div class="card" style="border: 1px solid var(--accent-primary); background: linear-gradient(180deg, rgba(16, 26, 21, 0.9) 0%, rgba(10, 16, 13, 0.95) 100%);">
      <div class="card-header">
        <div>
          <span class="exp-badge">LIVE PACK STATUS</span>
          <h2 style="font-size: 1.4rem;">Pack ID: <%= battery.batteryId %></h2>
          <p class="card-desc"><%= battery.batteryType %> &bull; <%= battery.cellCount %> Series Cells &bull; <%= battery.nominalCapacity %> Ah</p>
        </div>
        <div>
          <span class="badge <%= battery.batteryHealth === 'Good' ? 'badge-good' : 'badge-warning' %>">
            Health: <%= battery.batteryHealth %>
          </span>
        </div>
      </div>

      <div class="grid grid-cols-4" style="margin-top: 16px;">
        <div class="metric-card card" style="padding: 16px;">
          <div class="metric-label">Pack Voltage</div>
          <div class="metric-value-wrap">
            <span class="metric-value"><%= battery.voltage %></span>
            <span class="metric-unit">V</span>
          </div>
        </div>

        <div class="metric-card card" style="padding: 16px;">
          <div class="metric-label">Pack Current</div>
          <div class="metric-value-wrap">
            <span class="metric-value"><%= battery.current %></span>
            <span class="metric-unit">A</span>
          </div>
        </div>

        <div class="metric-card card" style="padding: 16px;">
          <div class="metric-label">State of Charge</div>
          <div class="metric-value-wrap">
            <span class="metric-value" style="color: var(--accent-neon);"><%= battery.chargePercentage %></span>
            <span class="metric-unit">%</span>
          </div>
        </div>

        <div class="metric-card card" style="padding: 16px;">
          <div class="metric-label">Instantaneous Power</div>
          <div class="metric-value-wrap">
            <span class="metric-value"><%= calculatedPower %></span>
            <span class="metric-unit">W</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Lab Experiments Breakdown -->
  <section style="margin-bottom: 30px;">
    <div style="text-align: center; margin-bottom: 24px;">
      <h2 style="font-size: 1.8rem;">Implemented Laboratory Experiments</h2>
      <p style="color: var(--text-muted);">All core exercises required by the syllabus are integrated into this working project.</p>
    </div>

    <div class="grid grid-cols-3">
      <!-- Exp 1 -->
      <div class="card">
        <span class="exp-badge">EXPERIMENT 1</span>
        <h3 style="margin-bottom: 8px;">Native HTTP Server</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 16px;">
          Created using Node's built-in <code>http</code> module displaying <em>"Battery Management System Server Running"</em>.
        </p>
        <div style="background: #09100d; padding: 8px 12px; border-radius: 6px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-neon);">
          npm run start:http (Port 3001)
        </div>
      </div>

      <!-- Exp 2 -->
      <div class="card">
        <span class="exp-badge">EXPERIMENT 2</span>
        <h3 style="margin-bottom: 8px;">Basic Routing &amp; JSON</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 16px;">
          Modular routes for <code>/</code>, <code>/battery</code>, <code>/status</code>, and <code>/about</code> with both HTML and dynamic JSON delivery.
        </p>
        <a href="/status" target="_blank" class="btn btn-outline btn-sm">Inspect /status JSON &rarr;</a>
      </div>

      <!-- Exp 3 -->
      <div class="card">
        <span class="exp-badge">EXPERIMENT 3</span>
        <h3 style="margin-bottom: 8px;">Callback Demonstration</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 16px;">
          Simulates battery health diagnosis with sequential console &amp; UI execution flow (Checking &rarr; Data Loaded &rarr; Callback Executed).
        </p>
        <a href="/battery#callback-section" class="btn btn-outline btn-sm">View Callback Flow &rarr;</a>
      </div>

      <!-- Exp 4 -->
      <div class="card">
        <span class="exp-badge">EXPERIMENT 4</span>
        <h3 style="margin-bottom: 8px;">File System (fs) Operations</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 16px;">
          Implements <code>readFileSync()</code>, <code>readFile()</code>, <code>writeFile()</code>, and <code>appendFile()</code> on <code>batteryData.json</code> and <code>logs.txt</code>.
        </p>
        <a href="/battery#fileops-section" class="btn btn-outline btn-sm">Test File Operations &rarr;</a>
      </div>

      <!-- Exp 5 -->
      <div class="card">
        <span class="exp-badge">EXPERIMENT 5</span>
        <h3 style="margin-bottom: 8px;">Custom Node.js Module</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 16px;">
          <code>batteryCalculator.js</code> calculates Power (P = V &times; I), Remaining Capacity (Ah), and Charging Efficiency (%).
        </p>
        <a href="/battery#calc-section" class="btn btn-outline btn-sm">Open Calculator &rarr;</a>
      </div>

      <!-- Exp 6 & 7 -->
      <div class="card">
        <span class="exp-badge">EXPERIMENTS 6 &amp; 7</span>
        <h3 style="margin-bottom: 8px;">Express &amp; EJS Engine</h3>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 16px;">
          Production-grade Express server with EJS template layouts, partials, static asset serving, and responsive CSS theme.
        </p>
        <a href="/about" class="btn btn-outline btn-sm">Architecture &amp; Docs &rarr;</a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
