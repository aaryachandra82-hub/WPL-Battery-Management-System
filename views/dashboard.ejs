<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container" style="flex: 1; padding: 30px 24px 60px;">
  <!-- Dashboard Top Bar -->
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 16px;">
    <div>
      <span class="exp-badge">LIVE BMS TELEMETRY &bull; EXPERIMENT 2 &amp; 7</span>
      <h1 style="font-size: 2.2rem;">Battery Telemetry Dashboard</h1>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        Real-time telemetry parsed from <code style="color: var(--accent-neon);">data/batteryData.json</code> via Node.js File System &amp; Custom Calculator.
      </p>
    </div>

    <div style="display: flex; gap: 12px; align-items: center;">
      <button id="btn-refresh-status" class="btn btn-outline btn-sm">
        🔄 Refresh Status
      </button>
      <a href="/status" target="_blank" class="btn btn-primary btn-sm">
        🔌 View Raw JSON (/status)
      </a>
    </div>
  </div>

  <% if (error) { %>
    <div class="card" style="border-color: var(--status-danger); margin-bottom: 24px; background: rgba(239, 68, 68, 0.1);">
      <h3 style="color: var(--status-danger);">⚠️ Error Loading Battery Data</h3>
      <p style="color: #fca5a5;"><%= error %></p>
    </div>
  <% } %>

  <% if (battery) { %>
  <!-- Primary Battery Header & Gauge -->
  <div class="battery-visual-box">
    <!-- Visual battery with glowing fill -->
    <div class="battery-frame">
      <div id="battery-charge-fill" class="battery-fill" style="width: <%= battery.chargePercentage %>%;"></div>
    </div>

    <div class="battery-info">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
        <div>
          <span style="font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase;">Battery Identifier</span>
          <h2 style="font-size: 1.6rem; color: #ffffff;" id="telemetry-batteryId"><%= battery.batteryId %></h2>
          <span style="font-size: 0.85rem; color: var(--text-dim);"><%= battery.batteryType %> &bull; <%= battery.nominalCapacity %> Ah Pack</span>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 0.85rem; color: var(--text-muted);">State of Charge (SoC)</span>
          <div class="charge-big"><span id="telemetry-soc"><%= battery.chargePercentage %></span><span style="font-size: 1.5rem;">%</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Primary Required Telemetry Cards (Grid of 6 required fields + calculated power) -->
  <!-- Required: Battery ID, Voltage, Current, Temperature, Charge Percentage, Battery Health, Calculated Power -->
  <div class="grid grid-cols-4" style="margin-bottom: 30px;">
    <!-- 1. Voltage Card -->
    <div class="card metric-card">
      <div class="card-header">
        <div class="metric-icon-wrap">⚡</div>
        <span class="badge badge-good">Nominal: <%= battery.nominalVoltage || 48 %>V</span>
      </div>
      <div class="metric-label">Pack Voltage</div>
      <div class="metric-value-wrap">
        <span class="metric-value" id="telemetry-voltage"><%= battery.voltage %></span>
        <span class="metric-unit">V</span>
      </div>
      <div class="metric-meta">
        <span>Safe: 42.0V - 58.4V</span>
        <span>Sensor: ADC-01</span>
      </div>
    </div>

    <!-- 2. Current Card -->
    <div class="card metric-card">
      <div class="card-header">
        <div class="metric-icon-wrap">🔌</div>
        <span class="badge <%= battery.chargingStatus === 'Discharging' ? 'badge-warning' : 'badge-good' %>">
          <%= battery.chargingStatus || 'Active' %>
        </span>
      </div>
      <div class="metric-label">Pack Current</div>
      <div class="metric-value-wrap">
        <span class="metric-value" id="telemetry-current"><%= battery.current %></span>
        <span class="metric-unit">A</span>
      </div>
      <div class="metric-meta">
        <span>Continuous Load</span>
        <span>Hall Effect Sensor</span>
      </div>
    </div>

    <!-- 3. Temperature Card -->
    <div class="card metric-card">
      <div class="card-header">
        <div class="metric-icon-wrap">🌡️</div>
        <span class="badge <%= battery.temperature < 45 ? 'badge-good' : 'badge-danger' %>">
          Limit &lt; 55°C
        </span>
      </div>
      <div class="metric-label">Pack Temperature</div>
      <div class="metric-value-wrap">
        <span class="metric-value" id="telemetry-temp"><%= battery.temperature %></span>
        <span class="metric-unit">°C</span>
      </div>
      <div class="metric-meta">
        <span>NTC Thermistors (x4)</span>
        <span>Thermal Status: Normal</span>
      </div>
    </div>

    <!-- 4. Calculated Power Card (Experiment 5 Custom Module) -->
    <div class="card metric-card">
      <div class="card-header">
        <div class="metric-icon-wrap">💡</div>
        <span class="badge badge-good">P = V &times; I</span>
      </div>
      <div class="metric-label">Calculated Power</div>
      <div class="metric-value-wrap">
        <span class="metric-value" id="telemetry-power"><%= calculatedPower %></span>
        <span class="metric-unit">W</span>
      </div>
      <div class="metric-meta">
        <span>Module: batteryCalculator.js</span>
        <span>~<%= (calculatedPower / 1000).toFixed(2) %> kW</span>
      </div>
    </div>

    <!-- 5. Charge Percentage (SoC) Card -->
    <div class="card metric-card">
      <div class="card-header">
        <div class="metric-icon-wrap">🔋</div>
        <span class="badge badge-good">SoC Level</span>
      </div>
      <div class="metric-label">Charge Percentage</div>
      <div class="metric-value-wrap">
        <span class="metric-value" style="color: var(--accent-neon);"><%= battery.chargePercentage %></span>
        <span class="metric-unit">%</span>
      </div>
      <div class="metric-meta">
        <span>Coulomb Counting</span>
        <span>Cycles: <%= battery.cycleCount || 142 %></span>
      </div>
    </div>

    <!-- 6. Battery Health (SoH) Card -->
    <div class="card metric-card">
      <div class="card-header">
        <div class="metric-icon-wrap">🛡️</div>
        <span class="badge <%= battery.batteryHealth === 'Good' ? 'badge-good' : 'badge-warning' %>">
          SoH State
        </span>
      </div>
      <div class="metric-label">Battery Health</div>
      <div class="metric-value-wrap">
        <span class="metric-value" style="font-size: 1.8rem;" id="telemetry-health"><%= battery.batteryHealth %></span>
      </div>
      <div class="metric-meta">
        <span>Internal Imp. &lt; 20mΩ</span>
        <span>Condition: Optimal</span>
      </div>
    </div>

    <!-- 7. Remaining Capacity Card -->
    <div class="card metric-card">
      <div class="card-header">
        <div class="metric-icon-wrap">⏱️</div>
        <span class="badge badge-good">Cap &times; SoC</span>
      </div>
      <div class="metric-label">Remaining Capacity</div>
      <div class="metric-value-wrap">
        <span class="metric-value"><%= remainingCapacity %></span>
        <span class="metric-unit">Ah</span>
      </div>
      <div class="metric-meta">
        <span>Total: <%= battery.nominalCapacity %> Ah</span>
        <span>Available Run</span>
      </div>
    </div>

    <!-- 8. Efficiency Card -->
    <div class="card metric-card">
      <div class="card-header">
        <div class="metric-icon-wrap">📈</div>
        <span class="badge badge-good">Pout / Pin</span>
      </div>
      <div class="metric-label">Efficiency</div>
      <div class="metric-value-wrap">
        <span class="metric-value"><%= efficiency %></span>
        <span class="metric-unit">%</span>
      </div>
      <div class="metric-meta">
        <span>Conversion Ratio</span>
        <span>Losses: ~<%= (100 - efficiency).toFixed(1) %>%</span>
      </div>
    </div>
  </div>

  <!-- Cell Voltage Matrix (16 Series Cells) -->
  <% if (battery.cells && battery.cells.length > 0) { %>
  <div class="card" style="margin-bottom: 30px;">
    <div class="card-header">
      <div>
        <h3 class="card-title">🔬 Individual Cell Telemetry (16S Configuration)</h3>
        <p class="card-desc">Individual cell balancing status monitored by onboard analog front-end (AFE)</p>
      </div>
      <span class="badge badge-good">Delta &Delta;V: 0.02V (Balanced)</span>
    </div>

    <div class="cell-grid">
      <% battery.cells.forEach(function(cell) { %>
        <div class="cell-pill">
          <span class="cell-num">CELL <%= cell.cellId %></span>
          <span class="cell-volts"><%= cell.voltage %>V</span>
        </div>
      <% }); %>
    </div>
  </div>
  <% } %>
  <% } %>

  <!-- Interactive Lab Experiments Workbench -->
  <div class="grid grid-cols-2" style="margin-bottom: 30px;">
    
    <!-- EXPERIMENT 3: Callback Demonstration Box -->
    <div class="card" id="callback-section">
      <div class="card-header">
        <div>
          <span class="exp-badge">EXPERIMENT 3 DEMO</span>
          <h3 class="card-title">Callback Pattern Health Check</h3>
          <p class="card-desc">Simulates asynchronous battery health diagnosis with callbacks</p>
        </div>
      </div>

      <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 14px;">
        Demonstrates the Node.js asynchronous error-first callback pattern:
        <code>checkBatteryHealthWithCallback((err, data) =&gt; { ... })</code>
      </p>

      <div class="terminal-window" style="margin-bottom: 16px;">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <span class="terminal-title">callback_trace.log</span>
        </div>
        <div class="terminal-body" id="callback-terminal-body">
          <div class="terminal-line info">&gt; Ready. Click the button below to trigger the callback workflow.</div>
          <div class="terminal-line info">&gt; Expected sequence:</div>
          <div class="terminal-line info">&gt; 1. Checking Battery...</div>
          <div class="terminal-line info">&gt; 2. Battery Data Loaded...</div>
          <div class="terminal-line info">&gt; 3. Callback Executed</div>
          <div class="terminal-line success">&gt; 4. Battery Health: Good</div>
        </div>
      </div>

      <button id="btn-run-callback" class="btn btn-primary" style="width: 100%;">
        ▶️ Run Callback Health Check
      </button>
    </div>

    <!-- EXPERIMENT 4: File Operations Box -->
    <div class="card" id="fileops-section">
      <div class="card-header">
        <div>
          <span class="exp-badge">EXPERIMENT 4 DEMO</span>
          <h3 class="card-title">File System (fs) Operations</h3>
          <p class="card-desc">Tests readFileSync, readFile, appendFile, and writeFile</p>
        </div>
      </div>

      <p style="font-size: 0.88rem; color: var(--text-secondary); margin-bottom: 14px;">
        Verifies both synchronous and asynchronous operations targeting <code>batteryData.json</code> and <code>logs.txt</code>:
      </p>

      <div class="terminal-window" style="margin-bottom: 16px;">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <span class="terminal-title">fs_operations.log</span>
        </div>
        <div class="terminal-body" id="fileops-terminal-body">
          <div class="terminal-line info">&gt; Ready. Click below to execute all 4 fs module methods.</div>
          <div class="terminal-line info">&gt; [1] fs.readFileSync()</div>
          <div class="terminal-line info">&gt; [2] fs.readFile()</div>
          <div class="terminal-line info">&gt; [3] fs.appendFile()</div>
          <div class="terminal-line info">&gt; [4] fs.writeFile()</div>
        </div>
      </div>

      <button id="btn-run-fileops" class="btn btn-primary" style="width: 100%;">
        ▶️ Test All File Operations
      </button>
    </div>
  </div>

  <!-- EXPERIMENT 5: Interactive Custom Module Calculator Section -->
  <div class="card" id="calc-section">
    <div class="card-header">
      <div>
        <span class="exp-badge">EXPERIMENT 5 DEMO</span>
        <h3 class="card-title">Custom Module Test Bench (<code style="color: var(--accent-neon);">batteryCalculator.js</code>)</h3>
        <p class="card-desc">Evaluate custom module calculations with interactive input parameters</p>
      </div>
    </div>

    <form id="form-bms-calculator">
      <div class="grid grid-cols-3" style="margin-bottom: 16px;">
        <div class="form-group">
          <label class="form-label" for="calc-voltage">Voltage (V):</label>
          <input type="number" step="0.01" class="form-input" id="calc-voltage" value="<%= battery ? battery.voltage : 51.84 %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="calc-current">Current (A):</label>
          <input type="number" step="0.01" class="form-input" id="calc-current" value="<%= battery ? battery.current : 14.50 %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="calc-capacity">Pack Capacity (Ah):</label>
          <input type="number" step="0.1" class="form-input" id="calc-capacity" value="<%= battery ? battery.nominalCapacity : 100 %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="calc-soc">Charge SoC (%):</label>
          <input type="number" min="0" max="100" class="form-input" id="calc-soc" value="<%= battery ? battery.chargePercentage : 84 %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="calc-pin">Input Power (W) for Efficiency:</label>
          <input type="number" step="0.1" class="form-input" id="calc-pin" value="800" required>
        </div>

        <div class="form-group" style="display: flex; align-items: flex-end;">
          <button type="submit" class="btn btn-primary" style="width: 100%;">
            ⚡ Calculate with Module
          </button>
        </div>
      </div>
    </form>

    <!-- Results display banner -->
    <div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 16px;">
      <div class="grid grid-cols-3" style="text-align: center;">
        <div>
          <span style="font-size: 0.8rem; color: var(--text-dim); text-transform: uppercase;">calculatePower()</span>
          <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent-neon); margin-top: 4px;" id="res-calc-power">
            <%= calculatedPower %> W
          </div>
        </div>
        <div>
          <span style="font-size: 0.8rem; color: var(--text-dim); text-transform: uppercase;">calculateRemainingCapacity()</span>
          <div style="font-size: 1.4rem; font-weight: 700; color: #ffffff; margin-top: 4px;" id="res-calc-capacity">
            <%= remainingCapacity %> Ah
          </div>
        </div>
        <div>
          <span style="font-size: 0.8rem; color: var(--text-dim); text-transform: uppercase;">calculateEfficiency()</span>
          <div style="font-size: 1.4rem; font-weight: 700; color: var(--accent-neon); margin-top: 4px;" id="res-calc-efficiency">
            <%= efficiency %> %
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Telemetry Update Timestamp -->
  <div style="margin-top: 24px; text-align: right; font-size: 0.8rem; color: var(--text-muted);">
    Telemetry Data Source: <code style="color: var(--accent-neon);">data/batteryData.json</code> &bull; Last synchronized: <span id="telemetry-updated"><%= battery ? new Date(battery.lastUpdated).toLocaleTimeString() : 'N/A' %></span>
  </div>
</main>

<%- include('partials/footer') %>
