<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container" style="flex: 1; padding: 40px 24px 60px;">
  <!-- About Hero -->
  <div style="margin-bottom: 36px; text-align: center;">
    <span class="exp-badge">ENGINEERING &bull; TELEMETRY PLATFORM</span>
    <h1 style="font-size: 2.6rem; margin-top: 8px;">About Battery Management System (BMS Pro)</h1>
    <p style="color: var(--text-secondary); max-width: 760px; margin: 12px auto 0; font-size: 1.05rem;">
      An industrial full-stack web application designed for real-time pack telemetry monitoring, cell balancing analytics, automated health diagnostics, and machine-readable data feeds.
    </p>
  </div>

  <!-- System Overview & BMS Principles -->
  <div class="grid grid-cols-2" style="margin-bottom: 36px;">
    <div class="card">
      <h3 style="font-size: 1.25rem; margin-bottom: 16px; color: var(--accent-neon);">🎯 System Purpose &amp; Capabilities</h3>
      <ul style="color: var(--text-secondary); font-size: 0.95rem; padding-left: 20px; line-height: 1.8;">
        <li>High-frequency non-blocking telemetry acquisition powered by Node.js.</li>
        <li>RESTful API gateway serving structured JSON telemetry to IoT edge devices.</li>
        <li>Asynchronous health diagnostics checking cell limits and thermal thresholds.</li>
        <li>Dual-mode persistent storage using synchronous reads and asynchronous audit logging.</li>
        <li>Integrated engineering calculator module for power, usable capacity, and efficiency.</li>
        <li>Responsive real-time dashboard rendered dynamically via EJS.</li>
      </ul>
    </div>

    <div class="card">
      <h3 style="font-size: 1.25rem; margin-bottom: 16px; color: var(--accent-neon);">🔋 What is a BMS?</h3>
      <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; margin-bottom: 12px;">
        A <strong>Battery Management System (BMS)</strong> is an electronic regulator that monitors and manages rechargeable lithium battery packs (LiFePO4, NMC).
      </p>
      <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7;">
        The system preserves battery lifespan, prevents thermal runaway, and ensures safe operation across continuous charge and discharge cycles:
      </p>
      <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px;">
        <span class="badge badge-good">Pack Voltage (V)</span>
        <span class="badge badge-good">Pack Current (A)</span>
        <span class="badge badge-good">Cell Balancing (16S)</span>
        <span class="badge badge-good">Thermal Limits (°C)</span>
        <span class="badge badge-good">State of Charge (SoC)</span>
        <span class="badge badge-good">State of Health (SoH)</span>
      </div>
    </div>
  </div>

  <!-- Architecture Flowchart / Diagram -->
  <div class="card" style="margin-bottom: 36px;">
    <h3 style="font-size: 1.25rem; margin-bottom: 16px;">🏛️ System Architecture &amp; Data Pipeline</h3>
    <div style="background: #030604; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 20px; font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent-neon); overflow-x: auto; line-height: 1.5;">
[Client Browser / Edge Client]
       │
       ├─── GET / (Overview) ────────────────&gt; [app.js] ───&gt; Render index.ejs
       ├─── GET /battery (Dashboard) ─────────&gt; [app.js] ───&gt; [modules/fileManager.js] ──&gt; (fs.readFile)
       │                                                                │
       │                                                                └───&gt; [modules/batteryCalculator.js]
       │                                                                            │
       │                                                                            └──&gt; Render dashboard.ejs
       │
       ├─── GET /status ──────────────────────&gt; [app.js] ───&gt; Returns JSON { batteryId, voltage, ... }
       │
       ├─── GET /api/callback ────────────────&gt; [app.js] ───&gt; checkBatteryHealthWithCallback()
       │                                                         (Checking -&gt; Loaded -&gt; Callback -&gt; Health: Good)
       │
       └─── GET /api/file-ops/test-all ───────&gt; [app.js] ───&gt; Verifies readFileSync, readFile, writeFile, appendFile
                                                                 (Reads/Writes data/batteryData.json, Appends data/logs.txt)
    </div>
  </div>

  <!-- Routing Table -->
  <div class="card" style="margin-bottom: 36px;">
    <h3 style="font-size: 1.25rem; margin-bottom: 16px;">🗺️ Application Routes &amp; API Specifications</h3>
    <div class="table-responsive">
      <table class="styled-table">
        <thead>
          <tr>
            <th>Route / Endpoint</th>
            <th>HTTP Method</th>
            <th>Type</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>/</code></td>
            <td>GET</td>
            <td>HTML (EJS)</td>
            <td>Landing page with system overview and live pack summary.</td>
          </tr>
          <tr>
            <td><code>/battery</code></td>
            <td>GET</td>
            <td>HTML (EJS)</td>
            <td>Full Battery Management Dashboard displaying voltage, current, temp, charge %, health, and calculated power.</td>
          </tr>
          <tr>
            <td><code>/status</code></td>
            <td>GET</td>
            <td>JSON</td>
            <td>Returns live battery telemetry in JSON format (batteryId, voltage, current, temperature, chargePercentage, batteryHealth).</td>
          </tr>
          <tr>
            <td><code>/about</code></td>
            <td>GET</td>
            <td>HTML (EJS)</td>
            <td>Renders the architecture overview and engineering technical specifications.</td>
          </tr>
          <tr>
            <td><code>/api/callback</code></td>
            <td>GET</td>
            <td>JSON / Event</td>
            <td>Executes the asynchronous health diagnostics pipeline.</td>
          </tr>
          <tr>
            <td><code>/api/file-ops/test-all</code></td>
            <td>GET</td>
            <td>JSON</td>
            <td>Executes and verifies storage methods: readFileSync, readFile, writeFile, and appendFile.</td>
          </tr>
          <tr>
            <td><code>/api/calculate</code></td>
            <td>POST</td>
            <td>JSON</td>
            <td>Custom module endpoint computing power, remaining capacity, and charging efficiency.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Module Specifications -->
  <div class="grid grid-cols-2">
    <div class="card">
      <h3 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--accent-neon);">📦 Calculation Module: <code>batteryCalculator.js</code></h3>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 12px;">
        Exported via <code>module.exports</code> with 3 core formulas:
      </p>
      <div style="font-family: var(--font-mono); font-size: 0.82rem; background: #08100c; padding: 12px; border-radius: 6px; color: #38bdf8;">
        1. calculatePower(voltage, current)<br>
        &nbsp;&nbsp;&nbsp;&rarr; P = V &times; I (Watts)<br><br>
        2. calculateRemainingCapacity(capacity, chargePercentage)<br>
        &nbsp;&nbsp;&nbsp;&rarr; Usable Ah = Capacity &times; (SoC / 100)<br><br>
        3. calculateEfficiency(inputPower, outputPower)<br>
        &nbsp;&nbsp;&nbsp;&rarr; &eta; (%) = (Pout / Pin) &times; 100
      </div>
    </div>

    <div class="card">
      <h3 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--accent-neon);">📁 Storage Module: <code>fileManager.js</code></h3>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 12px;">
        Native filesystem I/O operations:
      </p>
      <div style="font-family: var(--font-mono); font-size: 0.82rem; background: #08100c; padding: 12px; border-radius: 6px; color: #38bdf8;">
        1. fs.readFileSync('batteryData.json', 'utf-8')<br>
        &nbsp;&nbsp;&nbsp;&rarr; Synchronous boot load<br><br>
        2. fs.readFile('batteryData.json', 'utf-8', callback)<br>
        &nbsp;&nbsp;&nbsp;&rarr; Non-blocking asynchronous query<br><br>
        3. fs.writeFile('batteryData.json', json, callback)<br>
        &nbsp;&nbsp;&nbsp;&rarr; State updates<br><br>
        4. fs.appendFile('logs.txt', entry, callback)<br>
        &nbsp;&nbsp;&nbsp;&rarr; Audit trail logging
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
