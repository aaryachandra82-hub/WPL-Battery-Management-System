<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container" style="flex: 1; padding: 40px 24px 60px;">
  <!-- About Hero -->
  <div style="margin-bottom: 36px; text-align: center;">
    <span class="exp-badge">COLLEGE WEB DEVELOPMENT LAB &bull; EXPERIMENT 6</span>
    <h1 style="font-size: 2.6rem; margin-top: 8px;">About the Battery Management System (BMS)</h1>
    <p style="color: var(--text-secondary); max-width: 760px; margin: 12px auto 0; font-size: 1.05rem;">
      An end-to-end full-stack web application illustrating fundamental backend web technologies: HTTP servers, Express.js routing, EJS templating, asynchronous callbacks, the File System (<code style="color: var(--accent-neon);">fs</code>) module, and custom reusable modules.
    </p>
  </div>

  <!-- Academic Lab Details & Objectives -->
  <div class="grid grid-cols-2" style="margin-bottom: 36px;">
    <div class="card">
      <h3 style="font-size: 1.25rem; margin-bottom: 16px; color: var(--accent-neon);">🎯 Lab Aim &amp; Objectives</h3>
      <ul style="color: var(--text-secondary); font-size: 0.95rem; padding-left: 20px; line-height: 1.8;">
        <li>Demonstrate low-level native HTTP server creation using Node.js <code>http</code> module.</li>
        <li>Implement production RESTful routing and static asset delivery with Express.js.</li>
        <li>Master asynchronous programming and the error-first callback pattern in Node.js.</li>
        <li>Perform synchronous and asynchronous file system operations (<code>readFileSync</code>, <code>readFile</code>, <code>writeFile</code>, <code>appendFile</code>) on JSON and text files.</li>
        <li>Design and export reusable CommonJS custom modules (<code>batteryCalculator.js</code>).</li>
        <li>Dynamically render server-side views using the EJS (Embedded JavaScript) templating engine.</li>
        <li>Develop an industrial green/black responsive telemetry dashboard with CSS.</li>
      </ul>
    </div>

    <div class="card">
      <h3 style="font-size: 1.25rem; margin-bottom: 16px; color: var(--accent-neon);">🔋 What is a BMS?</h3>
      <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7; margin-bottom: 12px;">
        A <strong>Battery Management System (BMS)</strong> is an electronic regulator that monitors and controls rechargeable battery packs (e.g. Lithium-Ion, LiFePO4).
      </p>
      <p style="color: var(--text-secondary); font-size: 0.95rem; line-height: 1.7;">
        The BMS guarantees safety, longevity, and efficiency by continuously evaluating key metrics:
      </p>
      <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px;">
        <span class="badge badge-good">Pack Voltage (V)</span>
        <span class="badge badge-good">Pack Current (A)</span>
        <span class="badge badge-good">Cell Balancing</span>
        <span class="badge badge-good">Temperature (°C)</span>
        <span class="badge badge-good">State of Charge (SoC)</span>
        <span class="badge badge-good">State of Health (SoH)</span>
      </div>
    </div>
  </div>

  <!-- Architecture Flowchart / Diagram -->
  <div class="card" style="margin-bottom: 36px;">
    <h3 style="font-size: 1.25rem; margin-bottom: 16px;">🏛️ System Architecture &amp; Data Pipeline</h3>
    <div style="background: #030604; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 20px; font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent-neon); overflow-x: auto; line-height: 1.5;">
[Client Browser]
       │
       ├─── GET / (Home Page) ───────────────&gt; [app.js] ───&gt; Render index.ejs
       ├─── GET /battery (Dashboard) ─────────&gt; [app.js] ───&gt; [modules/fileManager.js] ──&gt; (fs.readFile)
       │                                                                │
       │                                                                └───&gt; [modules/batteryCalculator.js]
       │                                                                            │
       │                                                                            └───&gt; Render dashboard.ejs
       │
       ├─── GET /status ──────────────────────&gt; [app.js] ───&gt; Returns JSON { batteryId, voltage, ... }
       │
       ├─── GET /api/callback ────────────────&gt; [app.js] ───&gt; checkBatteryHealthWithCallback()
       │                                                         (Checking -&gt; Loaded -&gt; Callback -&gt; Health: Good)
       │
       └─── GET /api/file-ops/test-all ───────&gt; [app.js] ───&gt; Tests readFileSync, readFile, writeFile, appendFile
                                                                 (Reads/Writes data/batteryData.json, Appends data/logs.txt)
    </div>
  </div>

  <!-- Routing Table -->
  <div class="card" style="margin-bottom: 36px;">
    <h3 style="font-size: 1.25rem; margin-bottom: 16px;">🗺️ Application Routes &amp; API Specifications</h3>
    <div class="table-responsive">
      <table class="styled-table">
        <thead>
          <tr>
            <th>Route / Endpoint</th>
            <th>HTTP Method</th>
            <th>Type</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><code>/</code></td>
            <td>GET</td>
            <td>HTML (EJS)</td>
            <td>Renders the Home landing page with BMS overview and quick telemetry.</td>
          </tr>
          <tr>
            <td><code>/battery</code></td>
            <td>GET</td>
            <td>HTML (EJS)</td>
            <td>Full Battery Management Dashboard displaying voltage, current, temp, charge %, health, and calculated power.</td>
          </tr>
          <tr>
            <td><code>/status</code></td>
            <td>GET</td>
            <td>JSON</td>
            <td>Returns live battery telemetry in JSON format (batteryId, voltage, current, temperature, chargePercentage, batteryHealth).</td>
          </tr>
          <tr>
            <td><code>/about</code></td>
            <td>GET</td>
            <td>HTML (EJS)</td>
            <td>Renders the experiment overview, theoretical background, and syllabus mappings.</td>
          </tr>
          <tr>
            <td><code>/api/callback</code></td>
            <td>GET</td>
            <td>JSON / Event</td>
            <td>Executes the asynchronous callback demonstration simulating health diagnostics.</td>
          </tr>
          <tr>
            <td><code>/api/file-ops/test-all</code></td>
            <td>GET</td>
            <td>JSON</td>
            <td>Executes and verifies all 4 fs methods: readFileSync, readFile, writeFile, and appendFile.</td>
          </tr>
          <tr>
            <td><code>/api/calculate</code></td>
            <td>POST</td>
            <td>JSON</td>
            <td>Custom module endpoint computing power, remaining capacity, and charging efficiency.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Module Specifications -->
  <div class="grid grid-cols-2">
    <div class="card">
      <h3 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--accent-neon);">📦 Custom Module: <code>batteryCalculator.js</code></h3>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 12px;">
        Exported via <code>module.exports</code> with 3 mathematical functions:
      </p>
      <div style="font-family: var(--font-mono); font-size: 0.82rem; background: #08100c; padding: 12px; border-radius: 6px; color: #38bdf8;">
        1. calculatePower(voltage, current)<br>
        &nbsp;&nbsp;&nbsp;&rarr; P = V &times; I (Watts)<br><br>
        2. calculateRemainingCapacity(capacity, chargePercentage)<br>
        &nbsp;&nbsp;&nbsp;&rarr; Usable Ah = Capacity &times; (SoC / 100)<br><br>
        3. calculateEfficiency(inputPower, outputPower)<br>
        &nbsp;&nbsp;&nbsp;&rarr; &eta; (%) = (Pout / Pin) &times; 100
      </div>
    </div>

    <div class="card">
      <h3 style="font-size: 1.15rem; margin-bottom: 12px; color: var(--accent-neon);">📁 File System Module: <code>fileManager.js</code></h3>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 12px;">
        Interacts with the disk using Node's native <code>fs</code> library:
      </p>
      <div style="font-family: var(--font-mono); font-size: 0.82rem; background: #08100c; padding: 12px; border-radius: 6px; color: #38bdf8;">
        1. fs.readFileSync('batteryData.json', 'utf-8')<br>
        &nbsp;&nbsp;&nbsp;&rarr; Blocking synchronous read<br><br>
        2. fs.readFile('batteryData.json', 'utf-8', callback)<br>
        &nbsp;&nbsp;&nbsp;&rarr; Non-blocking asynchronous read<br><br>
        3. fs.writeFile('batteryData.json', json, callback)<br>
        &nbsp;&nbsp;&nbsp;&rarr; Overwrites current battery metrics<br><br>
        4. fs.appendFile('logs.txt', entry, callback)<br>
        &nbsp;&nbsp;&nbsp;&rarr; Records telemetry log events with timestamps
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
